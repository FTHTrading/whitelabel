# ==========================================================================
# UNYKORN ENTERPRISE FABRIC - ENVIRONMENT CONFIGURATION TEMPLATE
# (Non-Production Sample Values - Replace with Secure Secrets in Vault)
# ==========================================================================

# Server Configuration
PORT=8905
NODE_ENV=development
FABRIC_ENVIRONMENT=demo

# Multi-Tenant Database (PostgreSQL with Row-Level Security)
DATABASE_URL=postgresql://fabric_user:replace_with_db_password@localhost:5432/fabric_dev
DB_POOL_MAX=20

# Custody & Signing Integration (Sandbox Endpoint Only)
BITGO_ENV=sandbox
BITGO_ACCESS_TOKEN=replace_with_sandbox_token_from_vault
BITGO_ENTERPRISE_ID=replace_with_sandbox_enterprise_id

# Storage Configuration (Encrypted S3 Object Storage)
S3_BUCKET=unykorn-vault-evidence-sandbox
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_s3_key
S3_SECRET_ACCESS_KEY=replace_with_s3_secret

# Session & JWT Signing
JWT_SECRET=replace_with_min_256_bit_random_secret
SESSION_COOKIE_NAME=unykorn_fabric_session
